# Openloom — API Keys
# Copy this file to .env and fill in the keys you want to use.
# You only need ONE provider key to get started.
# The .env file is loaded automatically on startup.

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenRouter (access 300+ models with one key) ───────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google Gemini ───────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Groq (fast inference) ──────────────────────────────────
GROQ_API_KEY=

# ── Mistral ────────────────────────────────────────────────
MISTRAL_API_KEY=

# ── AWS Bedrock ─────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Openloom server (optional) ─────────────────────────────
# OPENLOOM_SERVER_PASSWORD=changeme

# ── Telegram Bot (get token from @BotFather on Telegram) ───
TELEGRAM_BOT_TOKEN=
